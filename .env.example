# Snowflake (from your trial account activation email)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FLIGHTLINE
SNOWFLAKE_RAW_SCHEMA=RAW

# Set to 1 to run the pipeline with synthetic data (no bts.gov dependency)
FLIGHTLINE_SAMPLE=1
FLIGHTLINE_DATA_DIR=/opt/airflow/project/data

# Dashboard backend: snowflake (trial) or duckdb (free, always-on mirror)
FLIGHTLINE_BACKEND=snowflake

# OpenSky (Phase 2 streaming path) - OAuth2 client credentials
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
